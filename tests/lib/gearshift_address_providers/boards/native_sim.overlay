/ {
	can_fake: can_fake {
		compatible = "zephyr,fake-can";
		status = "okay";
	};

	chosen {
		zephyr,canbus = &can_fake;
	};

	/* ACTIVE_HIGH so gpio_emul_input_set maps 1:1 to the encoded value. */
	gearshift: gearshift {
		compatible = "zephyr,binary-encoded-gpio";
		input-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>,
			      <&gpio0 1 GPIO_ACTIVE_HIGH>,
			      <&gpio0 2 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

/delete-node/ &can0;
